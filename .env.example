# Copie este fichero como ".env" para probar en local. En Coolify, ponga estas variables en "Environment Variables".

# Opcional: móvil (o móviles, separados por comas) de quien administra. La cuenta con ese móvil ve el panel /admin.
# También se puede crear un administrador con correo: python server.py crear-admin correo clave
ADMIN_PHONE=600000000

# Cómo contactar con usted para pedir un código de recuperación de clave. Se muestra en "He olvidado mi clave".
SUPPORT_CONTACT=WhatsApp 600 000 000

# Dirección pública de la app, para los enlaces de facturas e invitaciones que se envían por WhatsApp o correo.
# En local puede dejarla vacía.
PUBLIC_URL=https://alquileres.klyp.es

# Puerto y carpeta de datos (base de datos y PDF de facturas). En Docker ya vienen puestos.
# PORT=3000
# DATA_DIR=./data
