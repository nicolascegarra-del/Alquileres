# Copie este fichero como ".env" para probar en local. En Coolify, ponga estas variables en "Environment Variables".

# Móvil (o móviles, separados por comas) de quien administra. La cuenta que se registre con ese móvil ve el panel /admin.
ADMIN_PHONE=600000000

# Cómo contactar con usted para pedir un código de recuperación de clave. Se muestra en "He olvidado mi clave".
SUPPORT_CONTACT=WhatsApp 600 000 000

# Puerto y carpeta de datos (base de datos y fotos). En Docker ya vienen puestos.
# PORT=3000
# DATA_DIR=./data
